# ACE-Tool Environment Configuration

# ============================================================================
# Authentication Configuration (Priority Order)
# ============================================================================
# 1. Constructor parameters (highest priority, programmatic use only)
# 2. ~/.augment/session.json (recommended, created by `auggie login`)
# 3. AUGMENT_SESSION_AUTH environment variable (CI/CD, headless environments)
# 4. Legacy ACE_API_* variables (deprecated, backward compatibility only)

# --- New Authentication Format (Recommended) ---
# Option A: Use ~/.augment/session.json file (created by `auggie login`)
# session.json format:
# {
#   "accessToken": "your-token-here",
#   "tenantURL": "https://api.example.com/",
#   "scopes": ["email"]
# }

# Option B: Set AUGMENT_SESSION_AUTH environment variable (for CI/CD)
# AUGMENT_SESSION_AUTH='{"accessToken":"your-token","tenantURL":"https://api.example.com/"}'

# --- Legacy Authentication (Deprecated but still supported) ---
# ACE_API_URL=https://api.example.com
# ACE_API_TOKEN=your-api-token-here

# ============================================================================
# Prompt Enhancer Configuration
# ============================================================================

# Endpoint type: new, old, claude, openai, gemini, codex
# PROMPT_ENHANCER_ENDPOINT=new

# Legacy endpoint variable (fallback if PROMPT_ENHANCER_ENDPOINT not set)
# ACE_ENHANCER_ENDPOINT=new

# Third-party LLM configuration (required for claude/openai/gemini/codex endpoints)
# PROMPT_ENHANCER_BASE_URL=https://api.anthropic.com
# PROMPT_ENHANCER_TOKEN=sk-ant-your-key-here
# PROMPT_ENHANCER_MODEL=claude-sonnet-4.6  # Optional, overrides default model

# Enable search context injection for third-party endpoints
# PROMPT_ENHANCER_INCLUDE_SEARCH_CONTEXT=1

# ============================================================================
# Notes
# ============================================================================
# - Legacy ACE_API_URL/ACE_API_TOKEN are deprecated but supported for backward compatibility
# - New authentication format (session.json or AUGMENT_SESSION_AUTH) is recommended
# - Use `python scripts/ace_cli.py get_config` to verify current configuration
