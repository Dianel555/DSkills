# Augment API (for new/old endpoints)
ACE_API_URL=https://your-augment-api.com
ACE_API_TOKEN=your-augment-token

# Endpoint type: new, old, claude, openai, gemini, codex
# PROMPT_ENHANCER_ENDPOINT takes precedence over ACE_ENHANCER_ENDPOINT
PROMPT_ENHANCER_ENDPOINT=new
# ACE_ENHANCER_ENDPOINT=new

# ============================================================
# Third-party API Configuration
# Only required when endpoint is claude/openai/gemini/codex
#
# NOTE: PROMPT_ENHANCER_BASE_URL, PROMPT_ENHANCER_TOKEN, and
# PROMPT_ENHANCER_MODEL can only be set ONCE per .env file.
# Uncomment ONLY the section matching your chosen endpoint.
# ============================================================

# --- Claude (Anthropic) ---
# PROMPT_ENHANCER_BASE_URL=https://api.anthropic.com
# PROMPT_ENHANCER_TOKEN=sk-ant-xxx
# PROMPT_ENHANCER_MODEL=claude-sonnet-4-6

# --- OpenAI ---
# PROMPT_ENHANCER_BASE_URL=https://api.openai.com
# PROMPT_ENHANCER_TOKEN=sk-xxx
# PROMPT_ENHANCER_MODEL=gpt-5.4

# --- Codex (OpenAI Responses API) ---
# PROMPT_ENHANCER_BASE_URL=https://api.openai.com
# PROMPT_ENHANCER_TOKEN=sk-xxx
# PROMPT_ENHANCER_MODEL=gpt-5.4

# --- Gemini (Google) ---
# PROMPT_ENHANCER_BASE_URL=https://generativelanguage.googleapis.com
# PROMPT_ENHANCER_TOKEN=AIzaSyxxx
# PROMPT_ENHANCER_MODEL=gemini-3-flash-preview

# --- OpenAI-compatible (e.g., DeepSeek, Groq, local) ---
# PROMPT_ENHANCER_BASE_URL=https://api.deepseek.com
# PROMPT_ENHANCER_TOKEN=sk-xxx
# PROMPT_ENHANCER_MODEL=deepseek-chat

# ============================================================
# Search Context Injection (for third-party endpoints)
# When enabled, injects codebase search results into the prompt
# Requires ACE_API_URL, ACE_API_TOKEN, and --project-root
# ============================================================
# PROMPT_ENHANCER_INCLUDE_SEARCH_CONTEXT=1
