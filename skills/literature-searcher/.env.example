# Copy this file to .env and set the values for local use.
# Process environment variables take precedence over values in .env.

# Contact email used by CrossRef, OpenAlex, and Unpaywall.
LITERATURE_EMAIL=your_email@example.com

# Optional OpenAlex-specific contact email and API key.
OPENALEX_EMAIL=
OPENALEX_API_KEY=

# Optional Semantic Scholar API key.
SEMANTIC_SCHOLAR_API_KEY=

# Required only when using the Scopus searcher.
ELSEVIER_API_KEY=

# Required for monitor's default online DeepLX translation provider.
DEEPLX_ENDPOINT=

# Required only with: python -m literature_searcher.monitor --translator local_llm
# The URL is an OpenAI-compatible local API base, such as http://127.0.0.1:11434/v1.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
