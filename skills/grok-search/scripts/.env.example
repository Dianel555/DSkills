# GrokSearch CLI Configuration
# Copy this file to .env and fill in your values

# Required: Grok API endpoint (OpenAI-compatible format)
GROK_API_URL=https://your-api-endpoint.com/v1

# Required: Your API key
GROK_API_KEY=your-api-key-here

# Optional: Default model
GROK_MODEL=grok-4-1-fast

# Optional: Enable debug mode (true/false)
GROK_DEBUG=false

# Optional: Tavily API (for --extra-sources, --via tavily, web_map)
TAVILY_API_URL=https://api.tavily.com
TAVILY_API_KEY=
TAVILY_ENABLED=true

# Optional: Retry tuning (applies to Grok and Tavily HTTP calls)
GROK_RETRY_MAX_ATTEMPTS=3
GROK_RETRY_MULTIPLIER=1
GROK_RETRY_MAX_WAIT=10
