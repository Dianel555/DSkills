# GrokSearch CLI Configuration
# Copy this file to .env and fill in your values

# Required: Grok API endpoint (OpenAI-compatible format)
GROK_API_URL=https://your-api-endpoint.com/v1

# Required: Your API key
GROK_API_KEY=your-api-key-here

# Optional: Default model
GROK_MODEL=grok-4-1-fast

# Optional: Enable debug mode (true/false)
GROK_DEBUG=false

# Optional: Tavily API (for --extra-sources, --via tavily, web_map)
TAVILY_API_URL=https://api.tavily.com
TAVILY_API_KEY=
TAVILY_ENABLED=true

# Optional: Tavily search tuning
# search_depth: advanced(2 credits, highest relevance) | basic/fast/ultra-fast(1 credit)
#   advanced = niche topics, very recent pages, multi-facet queries (recommended for grounding)
#   basic    = general-purpose lookups where lower latency matters
TAVILY_SEARCH_DEPTH=advanced
# Snippets per source (1-5); higher = more grounding evidence per URL
TAVILY_CHUNKS_PER_SOURCE=3
# topic: general | news | finance  (news auto-adds published_date)
TAVILY_TOPIC=general
# time_range: day | week | month | year  (blank = no date filter)
TAVILY_TIME_RANGE=
# Domain filters, comma-separated. include_domains_mode: filter | boost
#   boost also searches the wide web, so trusted sources are prioritized without
#   risking empty results. Requires TAVILY_INCLUDE_DOMAINS to be set.
TAVILY_INCLUDE_DOMAINS=
TAVILY_EXCLUDE_DOMAINS=
TAVILY_INCLUDE_DOMAINS_MODE=filter
# include_answer: false | basic | advanced (LLM answer; extra cost, off by default)
TAVILY_INCLUDE_ANSWER=false
# Log credit usage in each response (useful when auditing cost)
TAVILY_INCLUDE_USAGE=false

# Optional: Tavily extract tuning (web_fetch --via tavily)
# extract_depth: basic(faster) | advanced(tables, JS-heavy pages, higher success)
#   Also applies to web_crawl extraction.
TAVILY_EXTRACT_DEPTH=basic
# Tavily-side timeout in seconds (API range 1.0-60.0)
TAVILY_EXTRACT_TIMEOUT=30

# Optional: Tavily crawl tuning (web_crawl)
# Crawl has its own rate limit: 100 RPM on both development and production keys.
# timeout: API range 10-150 seconds.
TAVILY_CRAWL_TIMEOUT=150
TAVILY_CRAWL_MAX_DEPTH=1
TAVILY_CRAWL_MAX_BREADTH=20
TAVILY_CRAWL_LIMIT=50
# Follow links to other domains (default true; set false to stay on one site)
TAVILY_CRAWL_ALLOW_EXTERNAL=true
# Path regexes, comma-separated (e.g. /docs/.*,/api/.*). Blank = no path filter.
TAVILY_CRAWL_SELECT_PATHS=
TAVILY_CRAWL_EXCLUDE_PATHS=

# Optional: Tavily research tuning (web_research)
# Research is async: the task is submitted, then polled until completed/failed.
# Its own rate limit is 20 RPM on both tiers — far tighter than search.
TAVILY_RESEARCH_MODEL=auto
TAVILY_RESEARCH_CITATION_FORMAT=numbered
TAVILY_RESEARCH_OUTPUT_LENGTH=standard
# Path to a JSON Schema file for structured output (blank = free-form text).
# Must have a non-empty "properties"; each property needs "type" + "description".
# Example:
#   {"properties": {"company": {"type": "string", "description": "The company name"}},
#    "required": ["company"]}
TAVILY_RESEARCH_OUTPUT_SCHEMA=
# Overall polling budget in seconds, and delay between status checks.
TAVILY_RESEARCH_TIMEOUT=300
TAVILY_RESEARCH_POLL_INTERVAL=5

# Optional: Retry tuning (applies to Grok and Tavily HTTP calls)
GROK_RETRY_MAX_ATTEMPTS=3
GROK_RETRY_MULTIPLIER=1
GROK_RETRY_MAX_WAIT=10
