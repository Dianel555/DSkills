# Required
EXA_API_KEY=your-api-key-here

# Optional API endpoint
# EXA_API_URL=https://api.exa.ai

# JSON debug events on stderr
# EXA_DEBUG=false

# Cap (seconds) for single retry wait + exponential backoff (default: 60)
# EXA_MAX_RETRY_WAIT=60

# Authentication scheme: x-api-key (default) or bearer for third-party endpoints
# EXA_AUTH_SCHEME=x-api-key
