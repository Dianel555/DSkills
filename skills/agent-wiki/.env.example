# agent-wiki environment variables (copy to .env or export in your shell).
# Values are read from the environment only; agent-wiki never writes them to disk.

# Agent-wiki source scope (alternative to passing --vault on every command).
# This may be the registered Obsidian root or a child source directory; each
# selected scope gets its own wiki/ tree.
AGENT_WIKI_VAULT=/path/to/your/obsidian/source-scope

# --- Optional: write wiki/index.md through the Obsidian Local REST API plugin ---
# When set, `gen-home` verifies the target and current content via the plugin,
# then uses a document-map version with conditional root PATCH so an open tab is
# not blindly replaced.
# A conflict or uncertain write stops; an unavailable/unset API -> atomic write.
# The API exposes only paths relative to the registered Obsidian root, so
# conditional REST writes require an explicit marker. On the first `gen-home`
# run with the two marker vars missing, agent-wiki creates a marker under the
# selected scope's wiki/, prints root-relative values, and stops; export them
# and retry. A nested scope's generated path includes its scope prefix. Existing
# markers are never overwritten. Get the key from Obsidian -> Settings -> Local
# REST API.
AGENT_WIKI_OBSIDIAN_API_KEY=
# Leave these blank initially; gen-home prints the correct root-relative path/value.
AGENT_WIKI_OBSIDIAN_VAULT_ID_PATH=
AGENT_WIKI_OBSIDIAN_VAULT_ID=

# Base URL of the plugin's server. Default below (HTTPS, self-signed cert on
# loopback). Use http://127.0.0.1:27123 if you enabled the insecure HTTP server.
AGENT_WIKI_OBSIDIAN_API_URL=https://127.0.0.1:27124
